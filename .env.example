PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
DB_FILE=aclc_library.sqlite
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-strong-unique-password
CORS_ORIGINS=http://localhost:5173
# Shared device credential for ESP32 gate passage requests; use a long random secret over HTTPS.
GATE_DEVICE_TOKEN=replace-with-a-long-random-device-secret
# Gmail SMTP: use a Google App Password (not your regular Gmail password).
GMAIL_USER=your-library-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
# Firebase Admin SDK for Auth and Firestore account sync. Set the Firebase project ID
# and provide either GOOGLE_APPLICATION_CREDENTIALS (recommended on servers) or
# FIREBASE_SERVICE_ACCOUNT_JSON as a secret containing the service-account JSON.
FIREBASE_PROJECT_ID=aclc-library-capstone
FIRESTORE_DATABASE_ID=default
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_ACCOUNT_SYNC_REQUIRED=true
# Local development: point to the private service-account file outside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/aclc-firebase-admin.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional server-side key for natural-language LIRA replies. Never place this in the mobile app.
# If unset, LIRA answers using ACLC FAQs, catalog search, and the signed-in user's own account data.
OPENAI_API_KEY=
LIRA_AI_MODEL=gpt-4o-mini
